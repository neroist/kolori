# Keep SDL3 binaries for ease of building on Windows
!SDL3.lib
!SDL3.dll

# AppDir generated by linuxdeploy to build AppImage
AppDir/

# Files generated by imgui
*.ini

# Screenshots from Kolori
kolori_screenshot*

# Release bundles
*.zip
*.AppImage

# Windows compiled resource files (exe icon)
*.res

# Static libraries
*.lib
*.a
*.la
*.lo

# Dyanmic libraries
*.dll
*.so
*.so.*
*.dylib

# Executables
kolori
*.exe
*.out
*.app
*.bin

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
